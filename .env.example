# Demo mode (default) needs only these two:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MODE=demo

# Live mode (MODE=live) additionally needs SHOPIFY_STORE_URL plus ONE of the
# two auth options below -- see the comment in
# data_source/live_shopify_source.py for when to use which.
SHOPIFY_STORE_URL=

# Option 1: a legacy custom app's static token (Settings > Apps and sales
# channels > Develop apps > Build legacy custom apps). Never expires on its
# own -- simplest option if that path is available on your store.
SHOPIFY_ACCESS_TOKEN=

# Option 2: a Dev Dashboard app's credentials, used via the client
# credentials grant. Only works when the app and store are in the same
# Shopify organization. No token to paste here -- it's fetched and cached
# automatically at runtime and expires every 24 hours.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional, MODE=live only. After the first run, sync_all.py automatically
# does incremental syncs (only records updated since the last run) using a
# watermark stored in the sync_state table. Set FULL_SYNC=true to force a
# full resync instead -- e.g. to reconcile deletions, which incremental
# syncs can't see (a deleted record's updated_at never changes).
FULL_SYNC=
